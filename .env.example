# Atoms Demo — environment variables
# Copy this file to `.env` and fill in real values when you reach the generate step.

# Which LLM provider to use: "mock" | "openai" | "anthropic" | "atoms"
# "mock" works with no API key — good for building/deploying the skeleton first.
LLM_PROVIDER=mock

# --- OpenAI-compatible (OpenAI, Atoms if OpenAI-compatible, etc.) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Atoms (fill in once you know the endpoint/format from the credit email) ---
ATOMS_API_KEY=
ATOMS_BASE_URL=
ATOMS_MODEL=
