# Atoms Demo — environment variables
# Copy this file to `.env` and fill in the keys for the models you want.
#
# HOW MODEL SELECTION WORKS
# -------------------------
# The app shows a model dropdown (Trae-style). A model only appears in the
# dropdown if its API key env var below is set. The keyless "Mock (no key)"
# option is always available, so the app runs out of the box with no keys.
# API keys stay on the server — the browser only ever sends a model id.
#
# Models tagged "vision" accept image attachments in the composer: doubao,
# openai (gpt-4o-mini), anthropic (claude-3.5-sonnet), BYOK. Text-only models
# grey out the attach button; the server also drops images for them.
#
# DEFAULT_MODEL_ID picks which model is selected on first load (optional).
#   e.g. DEFAULT_MODEL_ID=deepseek-chat
DEFAULT_MODEL_ID=mock

# --- Free / low-cost OpenAI-compatible providers -------------------------
# DeepSeek (direct) — ids: deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=

# Doubao / 豆包 (Volcano Ark) — id: doubao
# DOUBAO_MODEL may be a model id or an inference endpoint id (ep-xxxxxxxx).
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-250615

# Kimi / Moonshot — id: kimi
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k

# OpenRouter free tier — genuinely $0, great for demos.
# ids: openrouter-nemotron-free, openrouter-gptoss-free
OPENROUTER_API_KEY=

# --- Generic OpenAI-compatible (OpenAI / Groq / local / custom) ----------
# id: openai — set these to point at any OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) — premium option ---------------------------------
# id: anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# If the selected model errors (bad key/quota/network), fall back to mock
# instead of failing the request. Keep "true" so live demos never hard-error.
LLM_FALLBACK_TO_MOCK=true

# Neon Postgres connection string (optional — SQLite is used if unset).
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
