# Atoms Demo — environment variables
# Copy this file to `.env` and fill in real values when you reach the generate step.

# Which LLM provider to use: "mock" | "openai" | "anthropic"
# "mock" works with no API key — good for building/deploying the skeleton first.
LLM_PROVIDER=mock

# --- OpenAI-compatible endpoint (this is the "free model" seam) ---
# Works with OpenAI, OpenRouter, Groq, or any local OpenAI-compatible server.
# FREE option today (OpenRouter free tier):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your OpenRouter key>
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
# UPGRADE later (no code change) — swap to a stronger model:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) — premium option for later ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# If a real provider errors (bad key/quota/network), fall back to mock instead
# of failing the request. Keep "true" so live demos never hard-error.
LLM_FALLBACK_TO_MOCK=true
