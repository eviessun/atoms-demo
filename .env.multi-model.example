# ============================================================================
# Atoms Demo — 多模型 .env 模板（DeepSeek / 豆包 / Kimi / OpenRouter）
# ----------------------------------------------------------------------------
# 用法：把下面每个 <...> 占位符替换成你自己申请到的真实 key，然后另存为 .env
#   cp .env.multi-model.example .env
# 只有填了 key 的模型才会出现在界面下拉里；mock 永远可用。
# key 只存服务端，绝不下发浏览器。
# 支持识图（vision）的模型才接受输入框里的图片附件：doubao、openai(gpt-4o-mini)、
# anthropic(claude-3.5-sonnet)、BYOK；纯文本模型会置灰上传按钮，服务端也会丢弃图片。
# ============================================================================

# 首屏默认选中的模型 id（可选）。留空则用 mock。
# 想 0 成本测试，推荐用 OpenRouter 免费模型作默认：
DEFAULT_MODEL_ID=openrouter-nemotron-free


# --- DeepSeek（直连）------- 申请：https://platform.deepseek.com/api_keys ----
# 下拉 id：deepseek-chat、deepseek-reasoner。key 形如 sk-xxxxxxxx（约 32 位）。
DEEPSEEK_API_KEY=<在此粘贴你的 DeepSeek key，例如 sk-1234567890abcdef1234567890abcdef>


# --- 豆包 / 火山方舟 Ark ---- 申请：https://console.volcengine.com/ark -------
# 下拉 id：doubao。key 是一段 UUID 形式的字符串。
# DOUBAO_MODEL 可填模型名，或你的“推理接入点”id（ep-xxxxxxxx）。
DOUBAO_API_KEY=<在此粘贴你的 Ark key，例如 00000000-0000-0000-0000-000000000000>
DOUBAO_MODEL=doubao-seed-1-6-250615


# --- Kimi / Moonshot ------- 申请：https://platform.moonshot.cn/console/api-keys
# 下拉 id：kimi。key 形如 sk-xxxxxxxx。
MOONSHOT_API_KEY=<在此粘贴你的 Moonshot key，例如 sk-abcdefABCDEF0123456789abcdefABCD>
MOONSHOT_MODEL=moonshot-v1-8k


# --- OpenRouter（含免费模型）- 申请：https://openrouter.ai/keys ---------------
# 下拉 id：openrouter-nemotron-free、openrouter-gptoss-free（均免费）。
# key 形如 sk-or-v1-xxxxxxxx。
OPENROUTER_API_KEY=<在此粘贴你的 OpenRouter key，例如 sk-or-v1-0123456789abcdef0123456789abcdef>


# --- 选的模型报错时（key 失效/额度/网络）降级到 mock，别让演示硬失败 --------
LLM_FALLBACK_TO_MOCK=true


# --- 数据库（可选，不填则用本地 SQLite）-------------------------------------
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
